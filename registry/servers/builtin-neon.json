{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "npm/@neondatabase/mcp-server-neon",
  "title": "Neon",
  "description": "Neon serverless Postgres: branches, databases, SQL, and the Neon management API.",
