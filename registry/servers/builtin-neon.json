  "_meta": {
    "io.sami/gallery": {
      "legacyId": "builtin-neon",
      "icon": "neon",
      "iconBg": "#000000",
      "category": "Data",
      "maintained": "vendor",
      "toolsSummary": [
        {
          "name": "branches / sql / management API",
          "description": "Manage Neon projects, branches, databases, and run SQL via the Neon MCP server."
        }
      ],
