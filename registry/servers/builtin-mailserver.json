{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "npm/mcp-mail-server",
  "title": "Mail Server",
  "description": "Read and send mail over IMAP/SMTP against standard mail servers.",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/yunfeizhu/mcp-mail-server",
    "source": "github"
  },
  "websiteUrl": "https://github.com/yunfeizhu/mcp-mail-server",
  "_meta": {
    "io.sami/gallery": {
      "legacyId": "builtin-mailserver",
      "icon": "mail",
	  "iconMode": "mono",
      "iconBg": "#FFFFFF",
      "category": "Communication",
      "maintained": "community",
      "toolsSummary": [
        {
          "name": "imap / smtp mail",
          "description": "Read and send messages through standard IMAP/SMTP server connections."
        }
      ],
      "about": "Community MCP server for generic mail workflows over IMAP and SMTP providers.",
      "vendorLabel": "mcp-mail-server"
    },
    "io.sami/install": {
      "configSnippet": "{\n  \"mcpServers\": {\n    \"builtin-mailserver\": {\n      \"command\": \"npx\",\n      \"args\": [\n        \"-y\",\n        \"mcp-mail-server\"\n      ],\n      \"env\": {\n        \"IMAP_HOST\": \"imap.gmail.com\",\n        \"IMAP_PORT\": \"993\",\n        \"IMAP_SECURE\": \"true\",\n        \"SMTP_HOST\": \"smtp.gmail.com\",\n        \"SMTP_PORT\": \"465\",\n        \"SMTP_SECURE\": \"true\"\n      },\n      \"type\": \"stdio\"\n    }\n  }\n}"
    }
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "mcp-mail-server",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx",
      "environmentVariables": [
        {
          "name": "EMAIL_USER",
          "description": "Mailbox username/login for IMAP/SMTP authentication.",
          "isRequired": true,
          "isSecret": false
        },
        {
          "name": "EMAIL_PASS",
          "description": "Mailbox password or app password for IMAP/SMTP authentication.",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "IMAP_HOST",
          "description": "IMAP host (default: imap.gmail.com).",
          "isRequired": false,
          "isSecret": false,
          "default": "imap.gmail.com"
        },
        {
          "name": "IMAP_PORT",
          "description": "IMAP port (default: 993).",
          "isRequired": false,
          "isSecret": false,
          "default": "993"
        },
        {
          "name": "IMAP_SECURE",
          "description": "Whether IMAP uses TLS (default: true).",
          "isRequired": false,
          "isSecret": false,
          "default": "true"
        },
        {
          "name": "SMTP_HOST",
          "description": "SMTP host (default: smtp.gmail.com).",
          "isRequired": false,
          "isSecret": false,
          "default": "smtp.gmail.com"
        },
        {
          "name": "SMTP_PORT",
          "description": "SMTP port (default: 465).",
          "isRequired": false,
          "isSecret": false,
          "default": "465"
        },
        {
          "name": "SMTP_SECURE",
          "description": "Whether SMTP uses TLS (default: true).",
          "isRequired": false,
          "isSecret": false,
          "default": "true"
        }
      ]
    }
  ]
}
